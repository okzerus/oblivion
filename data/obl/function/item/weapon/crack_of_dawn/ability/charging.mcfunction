execute if score @s obl.holding_rmb matches 1 run function obl:item/weapon/crack_of_dawn/ability/start
execute if score @s obl.holding_rmb matches 30 run function obl:item/weapon/crack_of_dawn/ability/window_announcement
execute if score @s obl.holding_rmb matches 35 run function obl:item/weapon/crack_of_dawn/ability/window_fail
execute if score @s obl.holding_rmb matches 40 run function obl:item/weapon/crack_of_dawn/ability/activate