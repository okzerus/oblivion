                    "color": "#e4ad47",
                    "italic": false
                  },
                  {
                    "text": ";",
                    "color": "dark_green",
                    "italic": false
                  }
                ],
                [
                  {
                    "text": "     - Атаки наносят на 4 больше урона, накладывают ",
                    "color": "dark_green",
                    "italic": false
                  },
                  {
                    "text": "[Ожог]",
                    "color": "#eb5721",
