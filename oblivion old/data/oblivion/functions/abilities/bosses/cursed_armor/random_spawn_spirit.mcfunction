execute anchored eyes facing entity @e[type=vex,tag=obl.cursed_armor.minion,tag=!obl.done] feet run function oblivion:tech/raycast/facing.cursed_spirit
execute at @e[type=vex,tag=obl.cursed_armor.minion,tag=!obl.done] run particle flash ~ ~.3 ~
execute at @e[type=vex,tag=obl.cursed_armor.minion,tag=!obl.done] run playsound minecraft:entity.evoker.cast_spell hostile @a ~ ~ ~ 1.3 1.3
