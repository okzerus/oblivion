
# Hit sound
playsound minecraft:entity.player.attack.sweep hostile @a ~ ~ ~ 1 1.4
playsound minecraft:item.trident.hit hostile @a ~ ~ ~ 0.5 0.5

# AOE
tag @e[type=#oblivion:aoe,distance=..3] add obl.damaged_area
tag @p[tag=obl.temp.murasama.performing_dcross] remove obl.damaged_area

# Blood particles
execute at @e[type=#oblivion:canbleedparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block redstone_block ~ ~.5 ~ 0.2 0.2 0.2 0 10 force
execute at @e[type=#oblivion:canbleedgreenparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block green_wool ~ ~.5 ~ 0.2 0.2 0.2 0 10 force
execute at @e[type=#oblivion:canbleedpurpleparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block purple_wool ~ ~1.5 ~ 0.2 0.4 0.2 0 10 force

# Damage
execute as @p[tag=obl.temp.murasama.performing_dcross] unless entity @s[tag=obl.empowered.murasama] as @e[type=#oblivion:aoe,type=!player,tag=obl.damaged_area] run damage @s 12 trident by @p[tag=obl.temp.murasama.performing_dcross] from @p[tag=obl.temp.murasama.performing_dcross]
execute as @p[tag=obl.temp.murasama.performing_dcross] unless entity @s[tag=obl.empowered.murasama] as @e[type=player,tag=obl.damaged_area] run damage @s 6 trident by @p[tag=obl.temp.murasama.performing_dcross] from @p[tag=obl.temp.murasama.performing_dcross]
execute as @p[tag=obl.temp.murasama.performing_dcross] if entity @s[tag=obl.empowered.murasama] as @e[type=#oblivion:aoe,type=!player,tag=obl.damaged_area] run damage @s 16 trident by @p[tag=obl.temp.murasama.performing_dcross] from @p[tag=obl.temp.murasama.performing_dcross]
execute as @p[tag=obl.temp.murasama.performing_dcross] if entity @s[tag=obl.empowered.murasama] as @e[type=player,tag=obl.damaged_area] run damage @s 9 trident by @p[tag=obl.temp.murasama.performing_dcross] from @p[tag=obl.temp.murasama.performing_dcross]

# Cleanup
