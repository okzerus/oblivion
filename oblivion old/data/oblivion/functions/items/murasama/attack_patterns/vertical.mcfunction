# Randomizer
execute if entity @s[tag=obl.empowered.murasama] run function oblivion:rng

# Hit sound
playsound minecraft:entity.player.attack.sweep hostile @a ~ ~ ~ 1 1.4
playsound minecraft:item.trident.hit hostile @a ~ ~ ~ 0.5 0.5

# AOE
tag @e[type=#oblivion:aoe,tag=obl.temp.hit] add obl.damaged_area
tag @e[type=#oblivion:aoe,distance=..2] add obl.damaged_area
tag @s remove obl.damaged_area

# Blood particles
execute at @e[type=#oblivion:canbleedparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block redstone_block ~ ~.5 ~ 0.2 0.2 0.2 0 10 force
execute at @e[type=#oblivion:canbleedgreenparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block green_wool ~ ~.5 ~ 0.2 0.2 0.2 0 10 force
execute at @e[type=#oblivion:canbleedpurpleparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block purple_wool ~ ~1.5 ~ 0.2 0.4 0.2 0 10 force

# Damage
tag @s add obl.temp.owner
execute unless entity @s[tag=obl.empowered.murasama] as @e[type=#oblivion:aoe,type=!player,tag=obl.damaged_area] run damage @s 16 trident by @p[tag=obl.temp.owner] from @p[tag=obl.temp.owner]
execute unless entity @s[tag=obl.empowered.murasama] as @e[type=player,tag=obl.damaged_area] run damage @s 9 trident by @p[tag=obl.temp.owner] from @p[tag=obl.temp.owner]
execute if entity @s[tag=obl.empowered.murasama] as @e[type=#oblivion:aoe,type=!player,tag=obl.damaged_area] run damage @s 24 trident by @p[tag=obl.temp.owner] from @p[tag=obl.temp.owner]
execute if entity @s[tag=obl.empowered.murasama] as @e[type=player,tag=obl.damaged_area] run damage @s 14 trident by @p[tag=obl.temp.owner] from @p[tag=obl.temp.owner]

execute if entity @s[tag=obl.empowered.murasama] if score randomizer obl.rng matches 21..40 as @e[type=#oblivion:aoe,tag=obl.damaged_area,limit=1,sort=random] at @s if predicate oblivion:has.armor unless entity @s[tag=obl.brokenarmor] run tag @s add obl.temp.break_armor
execute as @e[type=#oblivion:aoe,tag=obl.temp.break_armor] run effect give @s unluck 10 0 false
execute as @e[type=#oblivion:aoe,tag=obl.temp.break_armor] at @s run function oblivion:tech/armorbreaking/add

# Collect blood
execute at @e[type=#oblivion:aoe,type=!player,tag=obl.damaged_area] run scoreboard players add @s[scores={obl.murasama.blood=..99}] obl.murasama.blood 1
execute at @e[type=player,tag=obl.damaged_area,scores={obl.shield_using=0}] run scoreboard players add @s[scores={obl.murasama.blood=..99}] obl.murasama.blood 1
execute at @e[type=#oblivion:aoe,type=!player,tag=obl.enraged,tag=obl.damaged_area] run scoreboard players add @s[scores={obl.murasama.blood=..99}] obl.murasama.blood 1
execute at @e[type=player,tag=obl.damaged_area,tag=obl.enraged,scores={obl.shield_using=0}] run scoreboard players add @s[scores={obl.murasama.blood=..99}] obl.murasama.blood 1

# Cleanup
tag @s remove obl.temp.owner
tag @e[type=#oblivion:aoe,tag=obl.damaged_area] remove obl.damaged_area
tag @e[type=#oblivion:aoe,tag=obl.temp.break_armor] remove obl.temp.break_armor





