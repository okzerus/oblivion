
# Hit sound
playsound minecraft:entity.player.attack.sweep hostile @a ~ ~ ~ 0.8 1.2
playsound minecraft:item.trident.hit hostile @a ~ ~ ~ 0.35 2

# AOE
tag @e[type=#oblivion:aoe,distance=..3] add obl.damaged_area
tag @p[tag=obl.temp.yamato.performing_shred] remove obl.damaged_area

# Blood particles
execute at @e[type=#oblivion:canbleedparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block redstone_block ~ ~.5 ~ 0.2 0.2 0.2 0 10 force
execute at @e[type=#oblivion:canbleedgreenparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block green_wool ~ ~.5 ~ 0.2 0.2 0.2 0 10 force
execute at @e[type=#oblivion:canbleedpurpleparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block purple_wool ~ ~1.5 ~ 0.2 0.4 0.2 0 10 force

# Damage
execute as @e[type=#oblivion:aoe,type=!player,tag=obl.damaged_area] run damage @s 8 trident by @p[tag=obl.temp.yamato.performing_shred] from @p[tag=obl.temp.yamato.performing_shred]
execute as @e[type=player,tag=obl.damaged_area] run damage @s 3 trident by @p[tag=obl.temp.yamato.performing_shred] from @p[tag=obl.temp.yamato.performing_shred]

# Cleanup
tag @e[type=#oblivion:aoe,tag=obl.damaged_area] remove obl.damaged_area





