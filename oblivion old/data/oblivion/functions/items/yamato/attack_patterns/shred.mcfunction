# Randomizer
execute if entity @s[tag=obl.empowered.yamato] run function oblivion:rng

# Hit sound
playsound minecraft:entity.player.attack.sweep hostile @a ~ ~ ~ 0.8 1.2
playsound minecraft:item.trident.hit hostile @a ~ ~ ~ 0.35 2


# AOE
tag @e[type=#oblivion:aoe,tag=obl.temp.hit] add obl.damaged_area
tag @e[type=#oblivion:aoe,distance=..3] add obl.damaged_area
tag @s remove obl.damaged_area

# Blood particles
execute at @e[type=#oblivion:canbleedparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block redstone_block ~ ~.5 ~ 0.2 0.2 0.2 0 10 force
execute at @e[type=#oblivion:canbleedgreenparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block green_wool ~ ~.5 ~ 0.2 0.2 0.2 0 10 force
execute at @e[type=#oblivion:canbleedpurpleparticle,tag=obl.damaged_area,tag=!obl.cantbleed,tag=!obl.witherinvul] run particle block purple_wool ~ ~1.5 ~ 0.2 0.4 0.2 0 10 force

# Damage
tag @s add obl.temp.owner
tag @s add obl.temp.yamato.performing_shred
execute as @e[type=#oblivion:aoe,type=!player,tag=obl.damaged_area] run damage @s 8 trident by @p[tag=obl.temp.owner] from @p[tag=obl.temp.owner]
execute as @e[type=player,tag=obl.damaged_area] run damage @s 3 trident by @p[tag=obl.temp.owner] from @p[tag=obl.temp.owner]

# Collect style
execute at @e[type=#oblivion:aoe,tag=obl.damaged_area] run scoreboard players add @s[scores={obl.yamato.style=..99}] obl.yamato.style 1
execute at @e[type=player,tag=obl.damaged_area,scores={obl.shield_using=0}] run scoreboard players add @s[scores={obl.yamato.style=..99}] obl.yamato.style 1

# Temp entity
execute if entity @e[type=#oblivion:aoe,tag=obl.temp.hit] run summon marker ~ ~ ~ {Tags:[obl.yamato_marker.shred,obl.yamato_marker.shred.1]}
execute unless entity @e[type=#oblivion:aoe,tag=obl.temp.hit] run summon marker ~ ~ ~ {Tags:[obl.yamato_marker.shred,obl.yamato_marker.shred.2]}
execute as @e[type=marker,tag=obl.yamato_marker.shred,limit=1,sort=nearest,tag=!obl.modified] at @s anchored eyes run tp @s ~ ~ ~ facing entity @p[tag=obl.temp.owner] eyes
tag @e[type=marker,tag=obl.yamato_marker.shred,limit=1,sort=nearest,tag=!obl.modified] add obl.modified

# Cleanup
tag @s remove obl.temp.owner
tag @e[type=#oblivion:aoe,tag=obl.damaged_area] remove obl.damaged_area





