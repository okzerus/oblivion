                {
                  "text": "There will be bloodshed",
                  "color": "#9c1111",
                  "italic": true
                },
                {
                  "text": "",
                  "color": "gray",
                  "italic": false
                },
                {
                  "text": "Когда в ведущей руке:",
                  "color": "gray",
                  "italic": false
                },
                {
                  "text": " Урон: 20",
                  "color": "dark_green",
                  "italic": false
                },
                {
                  "text": " Скорость атаки: 2.5",
                  "color": "dark_green",
                  "italic": false
                },
				[
                {
                  "text": " Удары в ближнем бою накапливают",
                  "color": "dark_green",
                  "italic": false
                },
                {
                  "text": " Кровь",
                  "color": "#d11212",
                  "italic": false
                }
				],
                {
                  "text": " Работает как щит, позволяя парировать атаки",
                  "color": "dark_green",
                  "italic": false
                },
				[
                {
                  "text": " Парирование атак ведущей рукой добавляет",
                  "color": "dark_green",
                  "italic": false
                },
                {
                  "text": " 5 Крови",
                  "color": "#d11212",
                  "italic": false
                }
				],
                {
                  "text": "",
                  "color": "gray",
                  "italic": false
                },
                {
                  "text": "Способности:",
                  "color": "gray",
                  "italic": false
                },
