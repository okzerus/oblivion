                {
                  "text": "[Л.РУКА], требуется",
                  "color": "gold",
                  "italic": false
                },
                {
                  "text": " 30 Крови",
                  "color": "#d11212",
                  "italic": false
                }
				],
                {
                  "text": "   Переместите катану в ножну, а затем",
                  "color": "yellow",
                  "italic": false
                },
                {
                  "text": "   выстрелите ею, чтобы нанести колоссальный",
                  "color": "yellow",
                  "italic": false
                },
                {
                  "text": "   разрез по площади.",
                  "color": "yellow",
                  "italic": false
                },
				[
                {
                  "text": "[ПРИСЕСТЬ], требуется",
                  "color": "gold",
                  "italic": false
                },
                {
                  "text": " 75 Крови",
                  "color": "#d11212",
                  "italic": false
                }
				],
