        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify Visualizer Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
